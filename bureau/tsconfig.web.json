{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@partage/*": ["../lib/reservation/*"] }
  },
  "include": ["src/renderer/**/*", "src/preload/*.d.ts", "src/partage/**/*", "../lib/reservation/caisseRegles.ts", "../lib/reservation/controles.ts", "../lib/reservation/dates.ts", "../lib/reservation/folio.ts", "../lib/reservation/devises.ts", "../lib/reservation/regles.ts", "../lib/reservation/statuts.ts", "../lib/reservation/tauxDeChange.ts", "../lib/reservation/types.ts"]
}
