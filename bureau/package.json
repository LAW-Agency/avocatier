{
  "name": "avocatier-hotes",
  "productName": "Chez L'Avocatier",
  "version": "1.2.0",
  "description": "Logiciel des hôtes de Chez L'Avocatier : demandes, planning, clients et tarifs",
  "author": "LAW Agency",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "paquet": "electron-vite build && electron-builder --win --publish never",
    "publier": "npm run paquet && node scripts/publier.mjs",
    "voix": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voix-visite.mjs",
    "voix:textes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/textes-voix.mjs",
    "voix:decouper": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/decouper-voix.mjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-datepicker-compat": "0.6.39",
    "@fluentui/react-icons": "2.0.343",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "exceljs": "4.4.0"
  }
}
