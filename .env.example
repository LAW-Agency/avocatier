# Variables d'environnement (copier en .env et remplir). Ne jamais commiter .env.

# Secret de signature du cookie de session : longue chaîne aléatoire, obligatoire en production
SESSION_SECRET=

# PostgreSQL (Neon : `neon env pull` les remplit) — adresse « -pooler » pour le site, directe pour les scripts
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Adresse publique du site, utilisée dans les liens des e-mails (sur Vercel, l'adresse de production par défaut)
SITE_URL=https://www.exemple.com

# E-mails : n'importe quel serveur SMTP (Brevo, Resend, OVH, serveur de l'agence…).
# Sans SMTP_HOST, les e-mails sont écrits dans .emails/ en développement et ne partent pas en production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur, d'un domaine validé chez le fournisseur SMTP
EMAIL_FROM="Chez L'Avocatier <reservations@exemple.com>"
# Boîte des hôtes : alertes de nouvelles demandes, et adresse de réponse des e-mails aux clients
EMAIL_HOTES=
